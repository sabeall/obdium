<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allows the hardened-runtime / notarized app to use Bluetooth (CoreBluetooth).
	     Required in addition to the NSBluetoothAlwaysUsageDescription in Info.plist. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
</dict>
</plist>
